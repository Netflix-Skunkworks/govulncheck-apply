# Two chained x/text vulns that one pass cannot clear.
#
# example.com/iter requires golang.org/x/text v0.3.5 and calls language.Parse.
# GO-TEST-0001 is fixed in v0.3.7, which is where GO-TEST-0002 is introduced
# (fixed in v0.3.8). Scanning v0.3.5 reports only GO-TEST-0001, so one pass
# raises the minimum required version to v0.3.7, which is still affected.
#
# Each module is rescanned until a pass changes neither go.mod nor go.sum, so the
# require directive moves v0.3.5 -> v0.3.7 -> v0.3.8, and both ids are reported
# as fixed.
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.Parse("en-US"))
}
-- go.mod --
module example.com/iter

go 1.23

require golang.org/x/text v0.3.5
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 0e79fc3..d3c1199 100644
--- a/go.mod
+++ b/go.mod
@@ -2,4 +2,4 @@ module example.com/iter
 
 go 1.23
 
-require golang.org/x/text v0.3.5
+require golang.org/x/text v0.3.8
diff --git a/go.sum b/go.sum
index bbd33e8..dee227d 100644
--- a/go.sum
+++ b/go.sum
@@ -1,3 +1,2 @@
-golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
-golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
-golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
+golang.org/x/text v0.3.8 h1:nAL+RVCQ9uMn3vJZbV+MRnydTJFPf8qqY42YiA6MrqY=
+golang.org/x/text v0.3.8/go.mod h1:E6s5w1FMmriuDzIBO73fBruAKo1PCIq6d2Q6DHfQ8WQ=
