# A main module with one called vulnerability in each of four golang.org/x
# dependencies.
#
# The four upgrades also raise the indirect requirement on golang.org/x/sys to
# v0.15.0, which golang.org/x/crypto v0.17.0 requires.
-- go.mod --
module example.com/vulnfour

go 1.23.0

require (
	golang.org/x/crypto v0.0.0-20220315160706-3147a52a75dd
	golang.org/x/image v0.0.0-20210216034530-4410531fe030
	golang.org/x/net v0.0.0-20220225172249-27dd8689420f
	golang.org/x/text v0.3.7
)

require golang.org/x/sys v0.0.0-20211216021012-1d35b9e2eb4e // indirect
-- main.go --
package main

import (
	"fmt"
	"io"
	"strings"

	"golang.org/x/crypto/ssh"
	"golang.org/x/image/tiff"
	"golang.org/x/net/html"
	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.ParseAcceptLanguage("en-US,en;q=0.9"))

	node, _ := html.Parse(strings.NewReader("<p>hi</p>"))
	html.Render(io.Discard, node)

	tiff.Decode(strings.NewReader(""))

	ssh.NewClientConn(nil, "", &ssh.ClientConfig{HostKeyCallback: ssh.InsecureIgnoreHostKey()})
}
