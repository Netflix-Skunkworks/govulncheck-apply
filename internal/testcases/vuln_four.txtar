-- main.go --
package main

import (
	"fmt"
	"io"
	"strings"

	"golang.org/x/crypto/ssh"
	"golang.org/x/image/tiff"
	"golang.org/x/net/html"
	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.ParseAcceptLanguage("en-US,en;q=0.9"))

	node, _ := html.Parse(strings.NewReader("<p>hi</p>"))
	html.Render(io.Discard, node)

	tiff.Decode(strings.NewReader(""))

	ssh.NewClientConn(nil, "", &ssh.ClientConfig{HostKeyCallback: ssh.InsecureIgnoreHostKey()})
}
