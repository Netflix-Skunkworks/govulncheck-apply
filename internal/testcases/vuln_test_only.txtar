# A vuln called only from an internal test file is never remediated.
#
# example.com/testonly requires golang.org/x/text v0.3.5, which carries
# GO-2021-0113. The only call to language.Parse is in lib_test.go, which belongs to
# package testonly rather than testonly_test. The scan passes -test, but
# govulncheck v1.6.0 surfaces such a call only from an external test package (see
# vuln_test_ext), not from an internal same-package one, so no finding is reported.
#
# want_diff.txt records what a scan covering internal test files would produce: the
# minimum required version of x/text raised to v0.3.7, and go.sum tidied.
#
# Skipped because the run produces no diff at all today.

skip: true
-- go.mod --
module example.com/testonly

go 1.23

require golang.org/x/text v0.3.5
-- lib.go --
package testonly

func Hello() string { return "hi" }
-- lib_test.go --
package testonly

import (
	"testing"

	"golang.org/x/text/language"
)

func TestParse(t *testing.T) {
	if _, err := language.Parse("en-US"); err != nil {
		t.Fatal(err)
	}
}
