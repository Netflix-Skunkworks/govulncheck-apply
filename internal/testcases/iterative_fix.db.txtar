# A minimal govulncheck DB with two golang.org/x/text/language.Parse vulns whose
# affected ranges do not overlap: GO-TEST-0001 (fixed in 0.3.7) and GO-TEST-0002
# (introduced 0.3.7, fixed 0.3.8). A scan of v0.3.5 sees only GO-TEST-0001, so a
# single pass lands on v0.3.7, which is still vulnerable to GO-TEST-0002.
-- index/db.json --
{"modified":"2026-07-22T00:00:00Z"}
-- index/modules.json --
[{"path":"golang.org/x/text","vulns":[{"id":"GO-TEST-0001","modified":"2026-07-22T00:00:00Z","fixed":"0.3.7"},{"id":"GO-TEST-0002","modified":"2026-07-22T00:00:00Z","fixed":"0.3.8"}]}]
-- ID/GO-TEST-0001.json --
{
  "id": "GO-TEST-0001",
  "database_specific": {"url": "https://pkg.go.dev/vuln/GO-TEST-0001"},
  "modified": "2026-07-22T00:00:00Z",
  "affected": [
    {
      "package": {"name": "golang.org/x/text", "ecosystem": "Go"},
      "ranges": [{"type": "SEMVER", "events": [{"introduced": "0"}, {"fixed": "0.3.7"}]}],
      "ecosystem_specific": {"imports": [{"path": "golang.org/x/text/language", "symbols": ["Parse"]}]}
    }
  ]
}
