# One unscannable module must not stop the others being remediated.
#
# The root example.com/root does not type-check, so govulncheck cannot load its
# packages and exits non-zero. Modules are visited outermost first, so a run that
# gave up at the first failure would never reach sub/, whose golang.org/x/text
# v0.3.6 carries GO-2021-0113, fixed in v0.3.7.
#
# Instead the root's failure is reported on stderr and in the summary, sub/ is
# remediated, and the run exits 0. Exiting non-zero would discard the fix that did
# land, since whatever commits the result reads a failure as "nothing changed".
-- broken.go --
package root

// Broken does not type-check, so govulncheck cannot load this module's packages
// and exits non-zero.
func Broken() int { return "not an int" }
-- go.mod --
module example.com/root

go 1.21.0
-- sub/go.mod --
module example.com/sub

go 1.25.0

require golang.org/x/text v0.3.6
-- sub/go.sum --
golang.org/x/text v0.3.6 h1:aRYxNxv6iGQlyVaZmk6ZgYEDa+Jg18DxebPSrd6bg1M=
golang.org/x/text v0.3.6/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- sub/sub.go --
package sub

import "golang.org/x/text/language"

// Parse is the vulnerable call path for GO-2021-0113.
func Parse(s string) (language.Tag, error) { return language.Parse(s) }
-- want_diff.txt --
diff --git a/sub/go.mod b/sub/go.mod
index 39ec510..5202102 100644
--- a/sub/go.mod
+++ b/sub/go.mod
@@ -2,4 +2,4 @@ module example.com/sub
 
 go 1.25.0
 
-require golang.org/x/text v0.3.6
+require golang.org/x/text v0.3.7
diff --git a/sub/go.sum b/sub/go.sum
index 3c12b4f..1f78e03 100644
--- a/sub/go.sum
+++ b/sub/go.sum
@@ -1,3 +1,2 @@
-golang.org/x/text v0.3.6 h1:aRYxNxv6iGQlyVaZmk6ZgYEDa+Jg18DxebPSrd6bg1M=
-golang.org/x/text v0.3.6/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
-golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
+golang.org/x/text v0.3.7 h1:olpwvP2KacW1ZWvsR7uQhoyTYvKAupfQrRGBFM352Gk=
+golang.org/x/text v0.3.7/go.mod h1:u+2+/6zg+i71rQMx5EYifcz6MCKuco9NR6JIITiCfzQ=
-- want_summary.json --
{
  "modules": [
    {
      "dir": ".",
      "error": "govulncheck: exit status 1"
    },
    {
      "dir": "sub",
      "fixed": [
        "GO-2021-0113"
      ]
    }
  ]
}
