# Two independent modules, both hitting the same standard-library vuln.
#
# Multi-module repo, no go.work: example.com/foo at the root and example.com/bar
# under sub/, both declaring go 1.21.0. Each calls net/http, which carries
# GO-2024-2687 / CVE-2023-45288, fixed in go1.21.9.
#
# Every module under the working directory is scanned, so both go directives move
# 1.21.0 -> 1.21.9, each in its own module rather than repository-wide.
#
# govulncheck takes the standard library version from the toolchain running the
# scan, not from the go directive, so the test names go1.21.0; a current toolchain
# would already be past the fix and report nothing.

gotoolchain: go1.21.0
-- go.mod --
module example.com/foo

go 1.21.0
-- main.go --
package main

import "net/http"

// net/http is the vulnerable stdlib package (GO-2024-2687), remediated by
// bumping the go directive.
func main() {
	http.Get("http://example.com/")
}
-- sub/go.mod --
module example.com/bar

go 1.21.0
-- sub/handler.go --
package sub

import (
	"net/http"
)

// Client fetches a URL using net/http. Go's net/http prior to go1.21.9 is
// affected by GO-2024-2687 (CVE-2023-45288): an attacker can cause unbounded
// memory growth by flooding HTTP/2 CONTINUATION frames.
func Client(url string) (*http.Response, error) {
	return http.Get(url)
}
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 9b981c3..d7e9510 100644
--- a/go.mod
+++ b/go.mod
@@ -1,3 +1,3 @@
 module example.com/foo
 
-go 1.21.0
+go 1.21.9
diff --git a/sub/go.mod b/sub/go.mod
index 4751ccc..fcedf44 100644
--- a/sub/go.mod
+++ b/sub/go.mod
@@ -1,3 +1,3 @@
 module example.com/bar
 
-go 1.21.0
+go 1.21.9
