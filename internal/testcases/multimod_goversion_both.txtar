description: Two independent modules, each with a stdlib net/http vuln.
skip: true

-- go.mod --
module example.com/foo

go 1.21.0
-- main.go --
package main

import "net/http"

func main() {
	http.Get("http://example.com/")
}
-- sub/go.mod --
module example.com/bar

go 1.21.0
-- sub/handler.go --
package sub

import (
	"net/http"
)

func Client(url string) (*http.Response, error) {
	return http.Get(url)
}
