# The main module has a vendor directory, so the upgrade has to be followed by
# `go mod vendor`.
#
# The fixture is self-consistent at HEAD: the require directive and
# vendor/modules.txt both record mousetrap v1.0.1. Rewriting go.mod and go.sum to
# v1.1.0 leaves modules.txt at v1.0.1, and `go mod tidy` does not re-sync the
# vendor directory, so every later go command fails:
#
#	go: inconsistent vendoring in /...:
#		github.com/inconshreveable/mousetrap@v1.1.0: is explicitly required in go.mod, but not marked as explicit in vendor/modules.txt
#		github.com/inconshreveable/mousetrap@v1.0.1: is marked as explicit in vendor/modules.txt, but not explicitly required in go.mod
#
# Nothing reports that at the time: the breakage surfaces one govulncheck run
# later, as a failure to load packages. That is how corp/sbos-nflx-system-agent
# and corp/wb-nflx-envvars broke. So govulncheck-apply runs `go mod vendor` after
# `go mod tidy` when vendor/modules.txt is present, and want_diff.txt covers the
# re-synced vendor directory as well as go.mod and go.sum.
#
# GO-TEST-0001 is synthetic. Every other case uses a real entry from the Go
# vulnerability database, but this one needs a dependency small enough to vendor
# into a fixture, and no such module has one -- mousetrap is 3 files where x/text
# is 424K. The module and both versions are real; only the vulnerability is
# invented.
-- go.mod --
module example.com/s

go 1.25.0

require github.com/inconshreveable/mousetrap v1.0.1
-- go.sum --
github.com/inconshreveable/mousetrap v1.0.1 h1:U3uMjPSQEBMNp1lFxmllqCPM6P5u/Xq7Pgzkat/bFNc=
github.com/inconshreveable/mousetrap v1.0.1/go.mod h1:vpF70FUmC8bwa3OWnCshd2FqLfsEA9PFc4w1p2J65bw=
-- main.go --
package main

import "github.com/inconshreveable/mousetrap"

func main() {
	_ = mousetrap.StartedByExplorer()
}
