description: A version `replace` pins x/text to a vulnerable version; the tool bumps only the `require` line, so the compiled version stays vulnerable while it reports success. Correct remediation bumps the replace target too.
skip: true
-- go.mod --
module example.com/replaceshadow

go 1.23

require golang.org/x/text v0.3.5

replace golang.org/x/text => golang.org/x/text v0.3.5
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() { fmt.Println(language.Parse("en-US")) }
