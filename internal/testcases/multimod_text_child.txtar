# A called x/text vuln in the nested module only.
#
# Multi-module repo, no go.work. The root example.com/foo is benign;
# example.com/foo/sub under sub/ requires golang.org/x/text v0.3.5 and calls
# language.Parse, which GO-2021-0113 affects; the fix is v0.3.7.
#
# Every module under the working directory is scanned, so sub/'s require directive
# moves v0.3.5 -> v0.3.7. Only sub/go.mod and sub/go.sum change: a module with
# nothing to fix is left byte for byte alone.
-- go.mod --
module example.com/foo

go 1.25.0
-- main.go --
package main

import "fmt"

func main() {
	fmt.Println("hello from the benign root module")
}
-- sub/go.mod --
module example.com/foo/sub

go 1.25.0

require golang.org/x/text v0.3.5
-- sub/lib.go --
package sub

import (
	"fmt"

	"golang.org/x/text/language"
)

// ParseTag calls language.Parse, which in golang.org/x/text v0.3.5 has an
// out-of-bounds read that can panic (a DoS) on malformed BCP 47 input.
func ParseTag(s string) string {
	tag, err := language.Parse(s)
	if err != nil {
		return fmt.Sprintf("error: %v", err)
	}
	return tag.String()
}
-- sub/go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- want_diff.txt --
diff --git a/sub/go.mod b/sub/go.mod
index e3397d8..75da157 100644
--- a/sub/go.mod
+++ b/sub/go.mod
@@ -2,4 +2,4 @@ module example.com/foo/sub
 
 go 1.25.0
 
-require golang.org/x/text v0.3.5
+require golang.org/x/text v0.3.7
diff --git a/sub/go.sum b/sub/go.sum
index bbd33e8..1f78e03 100644
--- a/sub/go.sum
+++ b/sub/go.sum
@@ -1,3 +1,2 @@
