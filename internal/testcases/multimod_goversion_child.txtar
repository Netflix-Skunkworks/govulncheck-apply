description: Multi-module repo where only the nested child has a stdlib net/http vuln.
skip: true

-- go.mod --
module example.com/foo

go 1.22.0
-- main.go --
package main

import "fmt"

func main() {
	fmt.Println("hello from example.com/foo")
}
-- sub/go.mod --
module example.com/foo/sub

go 1.21.0
-- sub/server.go --
package sub

import "net/http"

func Serve() (*http.Response, error) {
	return http.Get("http://example.com/")
}
