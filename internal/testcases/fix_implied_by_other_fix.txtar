# Two called vulns where upgrading x/net already carries x/crypto past its own
# fixed version.
#
# golang.org/x/crypto has GO-2023-2402 (fixed in v0.17.0) and golang.org/x/net
# has GO-2026-5942 (fixed in v0.56.0), both called. x/net v0.56.0 requires
# golang.org/x/crypto v0.53.0, so upgrading x/net alone already carries x/crypto
# past v0.17.0.
#
# `go get` treats its arguments as exact versions, so asking for both at once
# fails rather than choosing between the two versions of x/crypto:
#
#	go: golang.org/x/net@v0.56.0 requires golang.org/x/crypto@v0.53.0, not golang.org/x/crypto@v0.17.0
#
# Nothing is unsatisfiable here. A require directive is a minimum, and minimal
# version selection takes the highest version required anywhere in the module
# graph. So govulncheck-apply raises the minimums with `go mod edit -require` and
# lets `go mod tidy` resolve them: x/crypto lands at v0.53.0, above its own fixed
# version, so GO-2023-2402 is remediated too.
#
# Reduced from ghe/corp/ngo, where x/net v0.56.0 and golang.org/x/sys v0.44.0
# collided the same way.
-- go.mod --
module example.com/impliedfix

go 1.23.0

require (
	golang.org/x/crypto v0.0.0-20220315160706-3147a52a75dd
	golang.org/x/net v0.0.0-20220225172249-27dd8689420f
)

require golang.org/x/sys v0.0.0-20211216021012-1d35b9e2eb4e // indirect
-- main.go --
package main

import (
	"golang.org/x/crypto/ssh"
	"golang.org/x/net/dns/dnsmessage"
)

func main() {
	ssh.NewClientConn(nil, "", &ssh.ClientConfig{HostKeyCallback: ssh.InsecureIgnoreHostKey()})

	var m dnsmessage.Message
	m.Unpack(nil)
}
