# The same two chained x/text vulns, in a nested module.
#
# Multi-module repo, no go.work. The root example.com/iter is benign;
# example.com/iter/sub under sub/ requires golang.org/x/text v0.3.5 and calls
# language.Parse. GO-TEST-0001 is fixed in v0.3.7, which is where GO-TEST-0002
# is introduced (fixed in v0.3.8).
#
# Each module is rescanned until a pass changes neither go.mod nor go.sum, so
# sub/'s require directive moves v0.3.5 -> v0.3.7 -> v0.3.8. Only sub/go.mod and
# sub/go.sum change: the root has nothing to fix, and a module scanned from the
# repository root would not have been fixed at all, since ./... does not match
# packages in a nested module.
-- main.go --
package main

import "fmt"

func main() {
	fmt.Println("hello from the benign root module")
}
-- go.mod --
module example.com/iter

go 1.23
-- sub/go.mod --
module example.com/iter/sub

go 1.23

require golang.org/x/text v0.3.5
-- sub/lib.go --
package sub

import (
	"fmt"

	"golang.org/x/text/language"
)

// ParseTag calls language.Parse, the vulnerable symbol in x/text. v0.3.5 is hit
// by GO-TEST-0001 (fixed 0.3.7); v0.3.7 is still hit by GO-TEST-0002 (fixed
// 0.3.8), so a correct fix needs two sequential bumps.
func ParseTag(s string) {
	fmt.Println(language.Parse(s))
}
-- sub/go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- want_diff.txt --
diff --git a/sub/go.mod b/sub/go.mod
index 9c0d48a..bc53972 100644
--- a/sub/go.mod
+++ b/sub/go.mod
@@ -2,4 +2,4 @@ module example.com/iter/sub
 
 go 1.23
 
-require golang.org/x/text v0.3.5
+require golang.org/x/text v0.3.8
diff --git a/sub/go.sum b/sub/go.sum
index bbd33e8..dee227d 100644
--- a/sub/go.sum
+++ b/sub/go.sum
@@ -1,3 +1,2 @@
-golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
-golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
-golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
