-- testdata/anchor/go.mod --
module example.com/anchor

require (
	google.golang.org/genproto v0.0.0-20220921223823-23cae91e6737 // indirect
	google.golang.org/grpc v1.49.0
)

go 1.21
-- testdata/anchor/anchor.go --
package anchor

import _ "google.golang.org/grpc/credentials"

// Use gives the module under test something to import.
func Use() {}
