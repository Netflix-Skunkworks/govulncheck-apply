# A carve-out leaves two modules offering one package, and the fix is taken
# anyway.
#
# testdata/anchor stands in for a dependency that has not been released in a
# while, and sits under testdata/ so that it is a dependency rather than a
# second module to remediate. It requires google.golang.org/genproto
# v0.0.0-20220921223823-23cae91e6737, from before googleapis/go-genproto#1011
# moved googleapis/rpc into a module of its own.
#
# Raising google.golang.org/grpc to the version that fixes GO-2026-6061 brings
# that nested module in, and the version of the module around it still carries
# a copy of google.golang.org/genproto/googleapis/rpc/status, so `go mod tidy`
# finds the package in two modules and refuses. modfix reads both module paths
# out of tidy's own report, sees that one nests inside the other, requires the
# outer one at the nested one's version -- a commit from after the carve-out,
# in the same repository -- and tidies again.
#
# anchor imports google.golang.org/grpc/credentials rather than
# google.golang.org/grpc/status because it is that package's test that reaches
# the ambiguous import.
-- main.go --
package main

import "example.com/anchor"

func main() { anchor.Use() }
-- go.mod --
module example.com/foo

go 1.25.0

require example.com/anchor v0.0.0

require (
	github.com/golang/protobuf v1.5.2 // indirect
	google.golang.org/grpc v1.52.0 // indirect
	google.golang.org/protobuf v1.28.1 // indirect
)

replace example.com/anchor => ./testdata/anchor
