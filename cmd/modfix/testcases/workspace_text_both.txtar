# Both workspace modules require the same vulnerable x/text.
#
# The go.work variant of multimod_text_both. The root example.com/foo and
# example.com/foo/sub under sub/ each require golang.org/x/text v0.3.5 and call
# language.Parse, which GO-2021-0113 affects; the fix is v0.3.7. go.work's use
# directive names both.
#
# Scanning with GOWORK=off scans each module against its own go.mod, so each
# require directive moves v0.3.5 -> v0.3.7. With the workspace active, minimal
# version selection would give both main modules one selected version of x/text,
# so once the first module required v0.3.7 the second would scan clean and keep
# v0.3.5.
#
# Neither go.sum keeps the golang.org/x/tools hash once tidy has run, and the
# workspace's build list still needs it, so go.work.sum is written here for the
# first time.
-- go.mod --
module example.com/foo

go 1.25.0

require golang.org/x/text v0.3.5
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() {
	// language.Parse is the vulnerable symbol (GO-2021-0113); printing its
	// results directly keeps it on the call path so govulncheck flags it.
	fmt.Println(language.Parse("en-US"))
}
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- sub/go.mod --
module example.com/foo/sub

go 1.25.0

require golang.org/x/text v0.3.5
-- sub/lib.go --
package sub

import (
	"fmt"

	"golang.org/x/text/language"
)

// ParseTag calls language.Parse, the vulnerable symbol in x/text v0.3.5.
func ParseTag(s string) {
	fmt.Println(language.Parse(s))
}
-- sub/go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- go.work --
go 1.25.0

use (
	.
	./sub
)
-- want_diff.txt --
