# Both workspace modules change their go directive, so go.work must follow.
#
# The go.work variant of multimod_goversion_both. example.com/foo at the root
# and example.com/bar under sub/ both declare go 1.21.0 and call net/http, which
# carries GO-2024-2687 / CVE-2023-45288, fixed in go1.21.9. go.work's use
# directive names both and declares go 1.21.0.
#
# Scanning with GOWORK=off scans each module against its own go directive, so each
# moves to 1.21.9 independently. GOWORK=off also keeps both changes out of go.work,
# leaving its go directive below the modules it uses, and every workspace-mode
# command then fails with "module . listed in go.work file requires go >= 1.21.9".
# The `go work use` run afterwards raises go.work to match.

gotoolchain: go1.21.0
-- go.mod --
module example.com/foo

go 1.21.0
-- main.go --
package main

import "net/http"

// net/http is the vulnerable stdlib package (GO-2024-2687), remediated by
// bumping the go directive.
func main() {
	http.Get("http://example.com/")
}
-- sub/go.mod --
module example.com/bar

go 1.21.0
-- sub/handler.go --
package sub

import (
	"net/http"
)

// Client fetches a URL using net/http. Go's net/http prior to go1.21.9 is
// affected by GO-2024-2687 (CVE-2023-45288): an attacker can cause unbounded
// memory growth by flooding HTTP/2 CONTINUATION frames.
func Client(url string) (*http.Response, error) {
	return http.Get(url)
}
-- go.work --
go 1.21.0

use (
	.
	./sub
)
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 9b981c3..d7e9510 100644
--- a/go.mod
+++ b/go.mod
@@ -1,3 +1,3 @@
 module example.com/foo
 
-go 1.21.0
+go 1.21.9
diff --git a/go.work b/go.work
index 6b6b1d2..c971593 100644
--- a/go.work
+++ b/go.work
@@ -1,4 +1,4 @@
-go 1.21.0
+go 1.21.9
 
 use (
 	.
diff --git a/sub/go.mod b/sub/go.mod
index 4751ccc..fcedf44 100644
--- a/sub/go.mod
+++ b/sub/go.mod
@@ -1,3 +1,3 @@
 module example.com/bar
 
-go 1.21.0
+go 1.21.9
