# A `replace` directive holds x/text at the vulnerable v0.3.5, so raising the
# `require` directive alone would still build v0.3.5; govulncheck-apply rewrites
# the replacement version too.
#
# `replace golang.org/x/text => golang.org/x/text v0.3.5` names no version on the
# left, so every version of x/text in the module graph resolves to v0.3.5.
# Minimal version selection still runs over the require directives, but its
# result is then replaced: raising the require directive to v0.3.7 on its own
# leaves the build on v0.3.5, with GO-2021-0113 still present.
#
# bumpReplacedModules covers this. A replacement whose new module path equals the
# old one and carries a version substitutes a different version of the same
# module, so the fixed version applies to it as well, and both directives move to
# v0.3.7.
-- go.mod --
module example.com/replaceshadow

go 1.23

require golang.org/x/text v0.3.5

replace golang.org/x/text => golang.org/x/text v0.3.5
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() { fmt.Println(language.Parse("en-US")) }
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
