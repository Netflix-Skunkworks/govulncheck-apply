# One called golang.org/x/text vulnerability in the main module.
#
# govulncheck-apply bumps the `require` directive from v0.3.5 to the fixed
# v0.3.7. go.sum also loses the golang.org/x/tools go.mod hash: v0.3.5 declares
# `go 1.11`, so the main module loads its full module graph, while v0.3.7
# declares `go 1.17` and so is pruned.
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.Parse("en-US"))
}
-- go.mod --
module example.com/foo

go 1.25.0

require golang.org/x/text v0.3.5
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 4fde206..c86cdab 100644
--- a/go.mod
+++ b/go.mod
@@ -2,4 +2,4 @@ module example.com/foo
 
 go 1.25.0
 
-require golang.org/x/text v0.3.5
+require golang.org/x/text v0.3.7
diff --git a/go.sum b/go.sum
index bbd33e8..1f78e03 100644
--- a/go.sum
+++ b/go.sum
@@ -1,3 +1,2 @@
-golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
-golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
-golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
+golang.org/x/text v0.3.7 h1:olpwvP2KacW1ZWvsR7uQhoyTYvKAupfQrRGBFM352Gk=
+golang.org/x/text v0.3.7/go.mod h1:u+2+/6zg+i71rQMx5EYifcz6MCKuco9NR6JIITiCfzQ=
