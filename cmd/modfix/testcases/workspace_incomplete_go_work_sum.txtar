# go.work.sum is completed once the modules are done.
#
# go.work.sum holds the hashes a workspace needs beyond the ones its modules'
# own go.sum files carry. tools/ holds no package, so no scan reads it and
# nothing fills its empty go.sum: the hashes for golang.org/x/mod, and for the
# golang.org/x/tools that x/mod requires, have to come from go.work.sum. Only
# the x/mod ones are there.
#
# The root example.com/foo requires golang.org/x/text v0.3.5 and calls
# language.Parse, which GO-2021-0113 affects, so its require directive moves to
# v0.3.7. The tidy each module gets maintains the go.sum of the module it runs
# in and not the workspace's, so go.work.sum is written on its own once every
# module is done: the two golang.org/x/tools lines are what that adds.
-- go.mod --
module example.com/foo

go 1.25.0

require golang.org/x/text v0.3.5
-- main.go --
package main

import (
	"fmt"

	"golang.org/x/text/language"
)

func main() {
	// language.Parse is the vulnerable symbol (GO-2021-0113).
	fmt.Println(language.Parse("en-US"))
}
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- tools/go.mod --
module example.com/foo/tools

go 1.25.0

require golang.org/x/mod v0.8.0
-- tools/go.sum --
-- go.work --
go 1.25.0

use (
	.
	./tools
)
-- go.work.sum --
golang.org/x/mod v0.8.0 h1:LUYupSeNrTNCGzR/hVBk2NHZO4hXcVaW1k4Qx7rjPx8=
golang.org/x/mod v0.8.0/go.mod h1:iBbtSCu2XBx23ZKBPSOrRkjjQPZFPuis4dIYUhu/chs=
-- want_diff.txt --
