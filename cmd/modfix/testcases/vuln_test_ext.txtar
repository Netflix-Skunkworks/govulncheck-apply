# A called x/text vuln reachable only from an external test package.
#
# example.com/testext requires golang.org/x/text v0.3.5. The only call to
# language.Parse, which GO-2021-0113 affects, is in lib_test.go, declared
# package testext_test; package testext itself never reaches it. The fix is
# v0.3.7.
#
# The scan passes -test, so the external test package is scanned and the require
# directive moves v0.3.5 -> v0.3.7. A vulnerability only the tests reach is still
# one to fix.
-- go.mod --
module example.com/testext

go 1.23

require golang.org/x/text v0.3.5
-- lib.go --
package testext

func Hello() string { return "hi" }
-- lib_test.go --
package testext_test

import (
	"testing"

	"example.com/testext"
	"golang.org/x/text/language"
)

func TestHello(t *testing.T) {
	if testext.Hello() == "" {
		t.Fatal("empty")
	}
	if _, err := language.Parse("en-US"); err != nil {
		t.Fatal(err)
	}
}
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
