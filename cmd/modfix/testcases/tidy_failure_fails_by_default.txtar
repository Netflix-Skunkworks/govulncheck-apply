# The same run as tidy_failure_rolls_back_one_fix, without -best-effort: a fix
# that had to be rolled back fails the run by default.
#
# The diff is identical to that case. The default governs the exit status, not
# what is applied -- the x/text upgrade is still kept, and what is left on disk
# is a module that tidies and builds. So a caller that commits only on success
# leaves a partial remediation behind rather than carrying it unnoticed, and one
# that wants it asks for it.

exit: 1
-- go.mod --
module example.com/rollback

go 1.25.0

require (
	github.com/dgrijalva/jwt-go v3.2.0+incompatible
	golang.org/x/text v0.3.5
)
-- main.go --
package main

import (
	"fmt"

	"github.com/dgrijalva/jwt-go"
	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.Parse("en-US"))

	claims := jwt.MapClaims{"aud": "example.com"}
	fmt.Println(claims.VerifyAudience("example.com", true))
}
