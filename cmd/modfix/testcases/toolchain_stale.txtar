# A stdlib vulnerability fixed in Go 1.21.9, in a main module with
# `toolchain go1.21.4`.
#
# The `go` directive is bumped to 1.21.9, which leaves the toolchain directive
# below the required Go version, so it is removed.
#
# The standard library is read at the `go` directive rather than at the toolchain
# running the scan, so the case names no toolchain of its own.
-- go.mod --
module example.com/staletoolchain

go 1.21.0

toolchain go1.21.4
-- main.go --
package main

import "net/http"

func main() { http.Get("http://example.com/") }
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 1e5222d..ddd536d 100644
--- a/go.mod
+++ b/go.mod
@@ -1,5 +1,3 @@
 module example.com/staletoolchain
 
-go 1.21.0
-
-toolchain go1.21.4
+go 1.21.9
