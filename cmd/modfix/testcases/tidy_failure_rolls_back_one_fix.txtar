# One fix resolves and one does not, under -best-effort. The run keeps the x/text
# upgrade, rolls the jwt-go upgrade back so the module still tidies, and reports
# the one it gave up on as needing manual attention. It exits 0: a PR carrying
# the fix that landed is worth more than no PR at all, so long as the
# description says what is left.
#
# Without the flag the same run exits 1; tidy_failure_fails_by_default covers
# that, and the two cases assert the same diff, because what the flag governs is
# the exit status rather than what is applied.

args: -best-effort
-- go.mod --
module example.com/rollback

go 1.25.0

require (
	github.com/dgrijalva/jwt-go v3.2.0+incompatible
	golang.org/x/text v0.3.5
)
-- main.go --
package main

import (
	"fmt"

	"github.com/dgrijalva/jwt-go"
	"golang.org/x/text/language"
)

func main() {
	fmt.Println(language.Parse("en-US"))

	claims := jwt.MapClaims{"aud": "example.com"}
	fmt.Println(claims.VerifyAudience("example.com", true))
}
