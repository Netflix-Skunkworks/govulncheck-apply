# A cgo file in package main holding an import that no other file makes.
#
# This is the quiet half of the same build constraint. With cgo off, tag.go leaves
# package main, but nothing breaks: main.go still supplies func main, the module
# still lists, and the scan still runs and succeeds. What goes missing is silent.
# golang.org/x/text is reached only from the file that left, so GO-2021-0113 is
# never found, and the run reports that there was nothing to fix.
#
# That is worse than the failure cgo_package_loads covers, because a run that
# cannot read a module says so and stops, while this one opens a pull request
# claiming a module is clean.
#
# The env directive is a machine with no C compiler, where the go command turns
# cgo off by itself. Forcing cgo on holds tag.go in the package, which is what the
# diff and the report here assert: without it both would be empty.

env: CGO_ENABLED=0
-- go.mod --
module example.com/root

go 1.25.0

require golang.org/x/text v0.3.5
-- go.sum --
golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
-- main.go --
package main

func main() { println(tag()) }
-- tag.go --
package main

// The bare import is what makes this a cgo file, and what takes x/text out of the
// module's import graph when cgo is off.
import "C"

import "golang.org/x/text/language"

// tag reaches language.Parse, the symbol GO-2021-0113 affects.
func tag() string {
	t, _ := language.Parse("en-US")
	return t.String()
}
-- want_diff.txt --
diff --git a/go.mod b/go.mod
index 41296da..15f0ace 100644
--- a/go.mod
+++ b/go.mod
@@ -2,4 +2,4 @@ module example.com/root
 
 go 1.25.0
 
-require golang.org/x/text v0.3.5
+require golang.org/x/text v0.3.7
diff --git a/go.sum b/go.sum
index bbd33e8..1f78e03 100644
--- a/go.sum
+++ b/go.sum
@@ -1,3 +1,2 @@
-golang.org/x/text v0.3.5 h1:i6eZZ+zk0SOf0xgBpEpPD18qWcJda6q1sxt3S0kzyUQ=
-golang.org/x/text v0.3.5/go.mod h1:5Zoc/QRtKVWzQhOtBMvqHzDpF6irO9z98xDceosuGiQ=
-golang.org/x/tools v0.0.0-20180917221912-90fa682c2a6e/go.mod h1:n7NCudcB/nEzxVGmLbDWY5pfWTLqBcC2KZ6jyYvM4mQ=
+golang.org/x/text v0.3.7 h1:olpwvP2KacW1ZWvsR7uQhoyTYvKAupfQrRGBFM352Gk=
