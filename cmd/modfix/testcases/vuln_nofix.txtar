-- main.go --
package main

import (
	"fmt"

	"github.com/dgrijalva/jwt-go"
)

func main() {
	claims := jwt.MapClaims{"aud": "example.com"}
	ok := claims.VerifyAudience("example.com", true)
	fmt.Println("audience ok:", ok)
}
